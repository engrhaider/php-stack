# PHP version is selectable from .env via PHPVERSION (passed as a build arg).
# Any tag published as `php:<version>-fpm-bookworm` works, e.g. 8.1, 8.2, 8.3, 8.4.
ARG PHP_VERSION=8.4
FROM php:${PHP_VERSION}-fpm-bookworm

# Suppress debconf complaints when installing apt packages non-interactively
ARG DEBIAN_FRONTEND=noninteractive

# System libraries needed to build the PHP extensions below + handy CLI tools
RUN apt-get -y update && \
    apt-get -y --no-install-recommends install \
        git \
        curl \
        wget \
        unzip \
        zip \
        nano \
        default-mysql-client \
        libzip-dev \
        libicu-dev \
        libonig-dev \
        libsqlite3-dev \
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        libmagickwand-dev && \
    rm -rf /var/lib/apt/lists/*

# Core PHP extensions
RUN docker-php-ext-configure gd --enable-gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j"$(nproc)" \
        pdo_mysql \
        mysqli \
        pdo_sqlite \
        bcmath \
        zip \
        intl \
        mbstring \
        gettext \
        calendar \
        exif \
        gd

# PECL extensions: redis + xdebug, plus imagick built from source (the PECL
# release does not yet build cleanly on PHP 8.4)
RUN pecl install redis-6.2.0 && docker-php-ext-enable redis && \
    pecl install xdebug-3.4.5 && docker-php-ext-enable xdebug && \
    mkdir -p /var/log/xdebug

RUN cd /usr/local/src && \
    git clone --depth 1 https://github.com/Imagick/imagick && \
    cd imagick && \
    phpize && ./configure && make && make install && \
    docker-php-ext-enable imagick && \
    cd / && rm -rf /usr/local/src/imagick

# wkhtmltopdf (official build with patched Qt for proper header/footer/page-break
# rendering — the version in Debian's repo uses unpatched Qt). Architecture-aware
# so it works on both arm64 (Apple Silicon) and amd64 hosts.
RUN WKHTML_VERSION=0.12.6.1-3 && \
    ARCH="$(dpkg --print-architecture)" && \
    curl -fsSL -o /tmp/wkhtmltox.deb \
        "https://github.com/wkhtmltopdf/packaging/releases/download/${WKHTML_VERSION}/wkhtmltox_${WKHTML_VERSION}.bookworm_${ARCH}.deb" && \
    apt-get -y update && \
    apt-get -y --no-install-recommends install /tmp/wkhtmltox.deb && \
    rm -f /tmp/wkhtmltox.deb && \
    rm -rf /var/lib/apt/lists/*

# Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

WORKDIR /var/www/html