# To determine the name of your containers
COMPOSE_PROJECT_NAME=lamp

# --- Web (Caddy + PHP-FPM) ---------------------------------------------------
# Host directory holding your projects, mounted at /var/www in the containers.
DOCUMENT_ROOT=./projects
PHP_INI=./config/php/php.ini

# PHP version for the `app` (php-fpm) image. Supported: 8.1, 8.2, 8.3, 8.4
# After changing this, run: docker compose build app && docker compose up -d
PHPVERSION=8.4

# Xdebug (PHP 8.4 => Xdebug 3)
XDEBUG_PORT=9003

# --- phpMyAdmin --------------------------------------------------------------
UPLOAD_LIMIT=512M
MEMORY_LIMIT=512M

# --- Database (MySQL 8) ------------------------------------------------------
MYSQL_INITDB_DIR=./config/initdb
MYSQL_DATA_DIR=./data/mysql
MYSQL_LOG_DIR=./logs/mysql

# --- Host port mappings ------------------------------------------------------
# Change these if a port is already in use on your machine.
HOST_MACHINE_UNSECURE_HOST_PORT=80
HOST_MACHINE_SECURE_HOST_PORT=443
HOST_MACHINE_MYSQL_PORT=3306
HOST_MACHINE_PMA_PORT=8080
HOST_MACHINE_REDIS_PORT=6379

# --- MySQL credentials -------------------------------------------------------
# Local dev only — connect as root. Create databases yourself (via phpMyAdmin,
# a client, or an *.sql dump dropped in ./config/initdb on first start).
MYSQL_ROOT_PASSWORD=changeme